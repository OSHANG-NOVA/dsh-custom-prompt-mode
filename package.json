{
  "name": "dsh-custom-prompt-mode",
  "version": "1.0.0",
  "type": "module",
  "description": "Custom prompt 模式：用你自己写的系统提示词完全替换 DSH 的内置 System Prompt；自动扫描已安装插件的工具并逐项开关，工具说明可按所选模型汉化。",
  "license": "MIT",
  "author": "OSHANG-NOVA",
  "homepage": "https://github.com/OSHANG-NOVA/dsh-custom-prompt-mode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSHANG-NOVA/dsh-custom-prompt-mode.git"
  },
  "bugs": {
    "url": "https://github.com/OSHANG-NOVA/dsh-custom-prompt-mode/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "system-prompt",
    "custom-prompt"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./persona": "./persona.js",
    "./gate": "./gate.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "index.js",
    "persona.js",
    "gate.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ]
}
